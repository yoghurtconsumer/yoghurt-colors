<UserControl x:Class="Chromatic.App.Views.DisplayView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" />
    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="DESKTOP-WIDE COLOR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="{Binding ConnectionStatus}" Margin="0,10,0,8" AutomationProperties.Name="Display connection status" />
      <Button Content="Windows Display settings" Command="{Binding OpenDisplaySettingsCommand}" HorizontalAlignment="Left" ToolTip="Opens Settings; Chromatic does not change HDR or automatic color management." />
      <Button Content="Apply colors to desktop" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Apply global desktop colors" />
      <TextBlock Text="{Binding ApplyStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Desktop apply result" />
      <TextBlock Text="Games: desktop saturation targets Borderless/Windowed. Safe resolution/refresh notifications preserve confirmed SDR colors; HDR or monitor changes still suspend them." Style="{StaticResource Muted}" Margin="0,12,0,0" />
      <TextBlock Text="{Binding FullscreenStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
      <Button Content="Prepare NVIDIA vibrance (resets draft)" Command="{Binding PrepareNvidiaCommand}" HorizontalAlignment="Left" ToolTip="Preview only: sets saturation to neutral, vibrance to 75/100 and other controls to neutral. Requires explicit opt-in and Apply." />
      <TextBlock Text="Saturation" FontSize="20" Margin="0,18,0,4" />
      <TextBlock Text="{Binding Saturation, StringFormat={}{0:0}% · draft value}" />
      <Slider Minimum="0" Maximum="300" Value="{Binding Saturation}" TickFrequency="25" Margin="0,16,0,20" AutomationProperties.Name="Saturation draft percentage" />
      <TextBlock Text="{Binding Brightness, StringFormat=Brightness · {0:0.00}}" />
      <Slider Minimum="-0.25" Maximum="0.25" Value="{Binding Brightness}" Margin="0,8,0,16" AutomationProperties.Name="Brightness draft" />
      <TextBlock Text="{Binding Contrast, StringFormat=Contrast · {0:0.00}}" />
      <Slider Minimum="0.5" Maximum="2" Value="{Binding Contrast}" Margin="0,8,0,16" AutomationProperties.Name="Contrast draft" />
      <TextBlock Text="{Binding Warmth, StringFormat=Warmth · {0:0.00}}" />
      <Slider Minimum="-1" Maximum="1" Value="{Binding Warmth}" Margin="0,8,0,16" AutomationProperties.Name="Warmth draft" />
      <TextBlock Text="{Binding VibranceScale, StringFormat=Vibrance · {0:0} / 100 · 50 neutral}" />
      <Slider Minimum="0" Maximum="100" Value="{Binding VibranceScale}" AutomationProperties.Name="Vibrance separate scale, fifty neutral" />
      <TextBlock Text="Color accessibility approximation" Margin="0,12,0,4" />
      <ComboBox ItemsSource="{Binding CvdModes}" SelectedItem="{Binding CvdMode}" AutomationProperties.Name="Approximate CVD mode" />
      <Slider Minimum="0" Maximum="1" Value="{Binding CvdStrength}" AutomationProperties.Name="CVD approximation strength" />
      <Expander Header="Advanced global colour darkening" Margin="0,18,0,12" Foreground="{DynamicResource TextBrush}"><StackPanel>
        <TextBlock Text="Original desktop-wide colour transform. This does not identify reticles or hovered loot. All matching colours change, including terrain and other apps. Start with the samples below." Margin="0,8,0,10" />
        <TextBlock Text="{Binding HueRotation, StringFormat=Hue rotation · {0:0} degrees}" />
        <Slider Minimum="-180" Maximum="180" Value="{Binding HueRotation}" AutomationProperties.Name="Global hue rotation draft" />
        <TextBlock Text="{Binding DarkenHue, StringFormat=Hue to darken · {0:0} degrees · 0 red / 120 green / 240 blue}" />
        <Slider Minimum="0" Maximum="360" Value="{Binding DarkenHue}" AutomationProperties.Name="Global hue to darken" />
        <TextBlock Text="{Binding DarkenPercent, StringFormat=Colour darkening · {0:0}% · 0 off}" />
        <Slider Minimum="0" Maximum="400" Value="{Binding DarkenPercent}" AutomationProperties.Name="Global colour darkening percentage" />
        <Button Content="Reset colour darkening / hue rotation" Command="{Binding ResetAccentCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding AccentStatus}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="This affects the entire desktop and cannot isolate a holo sight or loot highlight. High strength can crush colours and detail. If the whole screen becomes too dark, use Restore, then reset colour darkening / hue rotation before applying again." Style="{StaticResource Muted}" />
      </StackPanel></Expander>
      <TextBlock Text="Optional SDR output · gamma/shadows/highlights (enable compatibility in Settings, save and restart)" TextWrapping="Wrap" Margin="0,16,0,4" />
      <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="GdiName" AutomationProperties.Name="Explicit SDR output" />
      <TextBlock Text="{Binding GammaStatus}" Style="{StaticResource Muted}" />
      <StackPanel IsEnabled="{Binding CanUseGamma}">
      <TextBlock Text="{Binding Gamma, StringFormat=Gamma · {0:0.00}}" /><Slider Minimum="0.5" Maximum="2.5" Value="{Binding Gamma}" AutomationProperties.Name="Gamma draft" />
      <TextBlock Text="Shadows" /><Slider Minimum="0" Maximum="0.8" Value="{Binding Shadows}" AutomationProperties.Name="Shadows draft" />
      <TextBlock Text="Highlights" /><Slider Minimum="0" Maximum="0.8" Value="{Binding Highlights}" AutomationProperties.Name="Highlights draft" />
      <TextBlock Text="Selected-output warmth · separate from global matrix warmth" /><Slider Minimum="-1" Maximum="1" Value="{Binding OutputWarmth}" AutomationProperties.Name="Per-output LUT warmth" />
      </StackPanel>
      <Button Content="Reset optional tones" Command="{Binding ResetTonesCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="APPROXIMATE SAMPLE PREVIEW · neutral calibration · original above, adjusted below" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
      <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,10,0,18">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,8,0"><Border Height="34" Background="{Binding Original}" /><Border Height="34" Background="{Binding Adjusted}" Margin="0,3,0,4" /><TextBlock Text="{Binding Label}" FontSize="11" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Reset draft" Command="{Binding ResetCommand}" HorizontalAlignment="Left" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="{Binding CapabilityStatus}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="{Binding Deferred}" Margin="0,10,0,0" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
