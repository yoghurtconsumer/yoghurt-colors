<UserControl x:Class="Chromatic.App.Views.ResolutionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" />
    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="{Binding CapabilityStatus}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
      <Button Content="Refresh monitors (read only)" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" AutomationProperties.Name="Display mode monitor" Margin="0,12,0,8" />
      <TextBlock Text="{Binding OutputStatus}" TextWrapping="Wrap" />
      <Button Content="Load supported modes (read only)" Command="{Binding LoadModesCommand}" HorizontalAlignment="Left" />
      <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Enumerated source mode and exact refresh" />
      <TextBlock Text="Output scaling request" Margin="0,12,0,4" />
      <ComboBox ItemsSource="{Binding ScalingOptions}" SelectedItem="{Binding Scaling}" AutomationProperties.Name="Draft output scaling" />
      <Button Content="Review mode plan (no display change)" Command="{Binding ReviewPlanCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Plan}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="Custom sizes must already be enumerated by your driver. No arbitrary timing creation, saved driver modes, game FOV changes or HDR writes are performed." Style="{StaticResource Muted}" Margin="0,12,0,8" />
      <TextBlock Text="{Binding Deferred}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
