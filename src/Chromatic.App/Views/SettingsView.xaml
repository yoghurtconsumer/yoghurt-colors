<UserControl x:Class="Chromatic.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" />
    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="When the window closes" FontSize="20" />
      <CheckBox Content="Keep running in the notification area" IsChecked="{Binding CloseToTray}" AutomationProperties.Name="Close to tray instead of exiting" />
      <TextBlock Text="Tray actions: Show, Pause, Restore and Exit. Exit always requests restoration." Style="{StaticResource Muted}" />
      <CheckBox Content="Opt in to SDR gamma compatibility (driver dependent)" IsChecked="{Binding GammaCompatibility}" AutomationProperties.Name="SDR gamma compatibility opt-in" />
      <CheckBox Content="Opt in to experimental private NVIDIA DVC" IsChecked="{Binding NvidiaExperimental}" AutomationProperties.Name="Experimental NVIDIA DVC opt-in" />
      <TextBlock Text="Save and restart to change compatibility services. Effects always start off." Style="{StaticResource Muted}" />
      <Button Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding SaveStatus}" />
      <TextBlock Text="Preset links (explicit per-user registration)" FontSize="20" Margin="0,20,0,6" />
      <TextBlock Text="Register only from a stable app folder. This writes your chromaticdesk URL handler in HKCU. Links show an import preview and cannot apply effects automatically." />
      <WrapPanel><Button Content="Register preset links" Command="{Binding RegisterProtocolCommand}" /><Button Content="Remove my registration" Command="{Binding UnregisterProtocolCommand}" /></WrapPanel>
      <TextBlock Text="{Binding ProtocolStatus}" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="{Binding CapabilityStatus}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="{Binding Deferred}" Margin="0,10,0,0" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
