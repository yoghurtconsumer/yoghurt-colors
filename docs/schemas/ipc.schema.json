        "brightness": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25
        },
        "contrast": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "gamma": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "vibrance": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "shadows": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "highlights": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "cvdMode": {
          "type": "string",
          "enum": [
            "None",
            "RedWeak",
            "GreenWeak",
            "BlueWeak"
          ]
        },
        "cvdStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
