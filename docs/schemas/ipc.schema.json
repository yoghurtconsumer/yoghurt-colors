                    "PowerSuspend",
                    "SessionDisconnected",
                    "AdvancedColor",
                    "Recovery"
                  ]
                }
              },
              "required": [
                "type",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "restore"
