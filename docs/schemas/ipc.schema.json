              "maxLength": 9
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "offsetX": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32768
            },
            "offsetY": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32768
            },
            "assetHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
