{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromaticdesktop.invalid/schemas/ipc.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "command"
        },
        "sessionId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "sessionId",
        "envelope"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "hello"
        },
        "processId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "processStartTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sessionId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "userSid": {
          "type": "string",
          "pattern": "^S-1-[0-9-]+$",
          "maxLength": 184
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "processId",
        "processStartTicks",
        "sessionId",
        "userSid",
        "nonce"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "result"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "$ref": "#/$defs/commandResult"
        },
        "completion": {
          "$ref": "#/$defs/applyResult"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "commandId",
        "decision",
        "completion",
        "state"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
