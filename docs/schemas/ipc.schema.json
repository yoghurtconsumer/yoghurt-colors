            "size": {
              "type": "integer",
              "minimum": 2,
              "maximum": 128
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "thickness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "outline": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{8}$",
