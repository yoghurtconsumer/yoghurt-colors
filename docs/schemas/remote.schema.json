{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromaticdesktop.invalid/schemas/remote.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "action": {
          "const": "SetColor"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "presetId": {
          "type": "null"
        }
      },
      "required": [
        "schemaVersion",
        "seq",
        "baseRevision",
        "action",
        "color",
        "presetId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "action": {
          "const": "ActivateScene"
        },
        "color": {
          "type": "null"
        },
        "presetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      },
      "required": [
        "schemaVersion",
        "seq",
        "baseRevision",
        "action",
        "color",
        "presetId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "action": {
          "const": "GetState"
        },
        "color": {
          "type": "null"
        },
        "presetId": {
          "type": "null"
        }
      },
      "required": [
        "schemaVersion",
        "seq",
        "baseRevision",
        "action",
        "color",
        "presetId"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "color": {
      "type": "object",
      "properties": {
        "saturationPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "brightness": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25
        },
        "contrast": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "gamma": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "vibrance": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "shadows": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "highlights": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "cvdMode": {
          "type": "string",
          "enum": [
            "None",
            "RedWeak",
            "GreenWeak",
            "BlueWeak"
          ]
        },
        "cvdStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "saturationPercent",
        "brightness",
        "contrast",
        "gamma",
        "warmth",
        "vibrance",
        "shadows",
        "highlights",
        "cvdMode"
      ],
      "additionalProperties": false
    }
  }
}
