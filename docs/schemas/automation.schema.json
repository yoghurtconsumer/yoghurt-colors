{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromaticdesktop.invalid/schemas/automation.schema.json",
  "$defs": {
    "color": {
      "type": "object",
      "properties": {
        "saturationPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "brightness": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25
        },
        "contrast": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "gamma": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "vibrance": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "shadows": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "highlights": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "cvdMode": {
          "type": "string",
          "enum": [
            "None",
            "RedWeak",
            "GreenWeak",
            "BlueWeak"
          ]
        },
        "cvdStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hueRotationDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "darkenHueDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "darkenStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "saturationPercent",
        "brightness",
        "contrast",
        "gamma",
        "warmth",
        "vibrance",
        "shadows",
        "highlights",
        "cvdMode"
      ],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "monitorDevicePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "edidSerial": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gdiName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "adapterLuid": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "targetId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "monitorDevicePath",
        "edidSerial",
        "gdiName",
        "adapterLuid",
        "targetId"
      ],
      "additionalProperties": false
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 16384
        },
        "refreshRate": {
          "$ref": "#/$defs/rational"
        },
        "scaling": {
          "type": "string",
          "enum": [
            "Unchanged",
            "Centered",
            "Stretched",
            "AspectRatio"
          ]
        },
        "hdr": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "width",
        "height",
        "refreshRate",
        "scaling",
        "hdr"
      ],
      "additionalProperties": false
    },
    "crosshair": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "shape": {
              "type": "string",
              "enum": [
                "Cross",
                "Dot",
                "Circle",
                "T",
                "DotCross"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 2,
              "maximum": 128
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "thickness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "outline": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{8}$",
              "minLength": 9,
              "maxLength": 9
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "offsetX": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32768
            },
            "offsetY": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32768
            },
            "assetHash": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "enabled",
            "shape",
            "size",
            "gap",
            "thickness",
            "outline",
            "color",
            "opacity",
            "offsetX",
            "offsetY",
            "assetHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "shape": {
              "const": "Picture"
            },
            "size": {
              "type": "integer",
              "minimum": 2,
              "maximum": 128
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "thickness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "outline": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{8}$",
              "minLength": 9,
              "maxLength": 9
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "offsetX": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32768
            },
            "offsetY": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32768
            },
            "assetHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "enabled",
            "shape",
            "size",
            "gap",
            "thickness",
            "outline",
            "color",
            "opacity",
            "offsetX",
            "offsetY",
            "assetHash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "monitor": {
      "type": "object",
      "properties": {
        "display": {
          "$ref": "#/$defs/display"
        },
        "gamma": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "display",
        "gamma",
        "warmth"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "globalColor": {
          "$ref": "#/$defs/color"
        },
        "monitors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monitor"
          },
          "maxItems": 32
        },
        "crosshair": {
          "$ref": "#/$defs/crosshair"
        },
        "displayIntent": {
          "oneOf": [
            {
              "$ref": "#/$defs/intent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "globalColor",
        "monitors",
        "crosshair",
        "displayIntent"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "automaticProfiles": {
      "type": "boolean"
    },
    "hotkeysEnabled": {
      "type": "boolean"
    },
    "mouseHolds": {
      "type": "boolean"
    },
    "acceptInjectedInput": {
      "type": "boolean"
    },
    "holdKeys": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 5,
        "maximum": 254
      },
      "maxItems": 4,
      "minItems": 1
    },
    "boost": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        },
        "redAttenuation": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "greenAttenuation": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "blueAttenuation": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        }
      },
      "required": [
        "enabled",
        "strength",
        "redAttenuation",
        "greenAttenuation",
        "blueAttenuation"
      ],
      "additionalProperties": false
    },
    "desktop": {
      "$ref": "#/$defs/profile"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "executablePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "executablePath",
          "profileId",
          "enabled"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "maxItems": 32
    },
    "hotkeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "modifiers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "key": {
            "type": "integer",
            "minimum": 5,
            "maximum": 254
          },
          "action": {
            "type": "string",
            "enum": [
              "Preset",
              "Pause",
              "Restore",
              "Screenshot"
            ]
          },
          "profileId": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "modifiers",
          "key",
          "action",
          "profileId"
        ],
        "additionalProperties": false
      },
      "maxItems": 24
    }
  },
  "required": [
    "schemaVersion",
    "automaticProfiles",
    "hotkeysEnabled",
    "mouseHolds",
    "acceptInjectedInput",
    "holdKeys",
    "boost",
    "desktop",
    "rules",
    "profiles",
    "hotkeys"
  ],
  "additionalProperties": false
}
