{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromaticdesktop.invalid/schemas/games.schema.json",
  "$defs": {},
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "games": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "executablePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "presetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          }
        },
        "required": [
          "id",
          "name",
          "executablePath",
          "presetId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "games"
  ],
  "additionalProperties": false
}
